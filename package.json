{
  "name": "pi-quota-bar",
  "version": "0.2.2",
  "type": "module",
  "description": "Composable quota bar with Codex, Kimi, new-api and DeepSeek query adapters",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "examples",
    "README.md"
  ],
